{
  "name": "@lexdraft/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node -e \"if(!process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD)require('child_process').execSync('playwright install --with-deps chromium',{stdio:'inherit'})\"",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config e2e/vitest.e2e.config.ts",
    "eval": "tsx eval/runner.ts",
    "eval:title-reports": "tsx eval/title-reports/runner.ts",
    "fetch:bns-bnss": "tsx scripts/fetch-bns-bnss.ts",
    "ingest:bns-bnss": "tsx scripts/ingest-bns-bnss.ts",
    "ingest:bns-local": "tsx scripts/ingest-bns-local.ts",
    "clean": "rm -rf dist .turbo",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:reset": "tsx src/scripts/migrate.ts --reset",
    "db:status": "tsx src/scripts/migrate.ts --status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "playwright": "^1.62.1",
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@lexdraft/types": "workspace:*",
    "@napi-rs/canvas": "0.1.100",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "openai": "^7.10.0",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "4.10.38",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lexdraft/eslint-config": "workspace:*",
    "@lexdraft/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.5",
    "eslint": "^8.57.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
