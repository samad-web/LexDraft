{
  "name": "@lexdraft/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo .vite",
    "build:mobile": "tsc -b --noCheck && vite build --mode mobile",
    "cap:sync": "pnpm build:mobile && cap sync android",
    "android:apk": "pnpm cap:sync && cd android && .\\gradlew.bat assembleDebug",
    "android:release": "pnpm cap:sync && cd android && .\\gradlew.bat assembleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@lexdraft/types": "workspace:*",
    "@lexdraft/ui": "workspace:*",
    "@tanstack/react-query": "^5.59.16",
    "@types/papaparse": "^5.5.2",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "1.4.0",
    "lenis": "^1.3.23",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@lexdraft/eslint-config": "workspace:*",
    "@lexdraft/tailwind-config": "workspace:*",
    "@lexdraft/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-query-devtools": "^5.59.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
